{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:browser": "playwright test",
    "dev": "vite",
    "build": "vite build && node scripts/emit-robots.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint src tools --fix",
    "lint:rules": "node tools/eslint-rules/verify.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json --noEmit",
    "check:cycles": "node tools/cycle-check.mjs",
    "check:countdown": "node tools/legacy-countdown.mjs",
    "verify:rules": "node tools/verify-rules-fire.mjs",
    "check:scope": "node tools/lint-scope.mjs",
    "check:exceptions": "node tools/verify-exceptions.mjs",
    "verify:scope-guard": "node tools/verify-scope-guard.mjs",
    "check:wardrobe-assets": "node tools/verify-wardrobe-manifest.mjs",
    "check:fabric-shots": "node tools/verify-fabric-shots.mjs",
    "gen:fabric-shots": "node tools/generate-fabric-shots.mjs",
    "check:asset-paths": "node tools/verify-asset-paths.mjs",
    "audit:assets": "node tools/asset-audit.mjs",
    "baseline": "node tools/render-baseline.mjs",
    "baseline:update": "node tools/render-baseline.mjs --update",
    "check:architecture": "node tools/check-architecture.mjs",
    "check:performance": "node tools/check-performance.mjs",
    "check:lint": "node tools/check-lint.mjs",
    "check:security": "node tools/check-security.mjs",
    "verify": "npm run typecheck && npm run check:architecture && npm run lint:rules && npm run verify:rules && npm run check:lint && npm run check:asset-paths && npm run check:wardrobe-assets && npm run check:fabric-shots && npm run build && npm run check:performance && npm run check:security",
    "test:domain": "playwright test --project=domain"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/three": "^0.185.4",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.1",
    "resend": "^6.18.1",
    "stripe": "^22.4.0",
    "three": "^0.185.1",
    "validator": "13.15.35",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@netlify/functions": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/validator": "13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.35",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
