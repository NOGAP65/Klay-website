# ---------------------------------------------------------------------------
# Klay — booking and payments configuration.
#
# Copy to `.env` for local `netlify dev`, and set the same keys in
# Netlify → Site configuration → Environment variables for production.
# `.env` is gitignored. Never commit real keys.
#
# THE ONE RULE: only VITE_-prefixed variables reach the browser. Everything
# below is deliberately unprefixed, because every one of them is a secret that
# would let someone else spend money or read the database. If you ever find
# yourself adding VITE_ to one of these to "make it work", stop — the thing that
# needs it belongs in a Netlify function instead.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Project settings → Data API → Project URL
SUPABASE_URL=https://your-project.supabase.co
# Project settings → API keys → service_role. Bypasses row level security;
# treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ----------------------------------------------------------------
# Developers → API keys → Secret key. Use the sk_test_… key until you have
# tested a full payment, then swap to sk_live_….
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret (whsec_…).
# Without this the webhook rejects everything and orders never reach `paid`.
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) --------------------------------------------------------
# resend.com → API keys
RESEND_API_KEY=
# Where "new enquiry" and "PAID" alerts land.
KLAY_NOTIFY_TO=vedant@nogap.net.au
# Must be on a domain verified in Resend. The onboarding@resend.dev default
# works immediately but only delivers to your own Resend account address, so
# customer acknowledgements will not arrive until a real domain is verified.
KLAY_NOTIFY_FROM=Klay Interiors <onboarding@resend.dev>

# --- Site ------------------------------------------------------------------
# Used to build Stripe's success/cancel URLs. Netlify injects URL automatically
# in production, so this is only needed locally.
SITE_URL=http://localhost:8888
