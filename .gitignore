# tsc -b incremental build cache (the typecheck gate)
*.tsbuildinfo

# --- generated during development, never deliverables --------------------------
# Screenshots the visualiser work leaves at the repo root. Nothing at the root is
# a tracked image — every real asset lives under public/ — so these are ignored by
# pattern rather than one by one, and the pattern is anchored to the root so a
# genuine public/ asset can never be caught by it.
/curtain-*.png
/*-screenshot.png
/screenshot*.png
/shot-*.png

# Throwaway visual audits written during a session. The architecture record lives
# in docs/architecture/; these are working notes and are not it.
/docs/VISUAL_AUDIT*.md

# eslint machine-readable output, written by the re-measure command in
# docs/architecture/LINT_BASELINE.md.
/lint.json

# Claude Code per-machine settings. A global ignore in ~/.config/git/ignore was
# protecting these on one machine only, which is why a copy of one had been sitting
# inside public/images/ — inside the WEB ROOT — since July, one `git add -A` away
# from being deployed and publicly downloadable. Ignored at repo level so the
# protection travels with the repository.
# .claude/settings.json is the shared, tracked one and is deliberately NOT ignored.
.claude/settings.local*.json

# Large source assets: originals that production never serves. They live outside
# public/ so they cannot be published by accident, and outside git because they are
# tens of megabytes of binaries with no diff.
/assets-source/

# The render baseline PNGs are the human artefact, the JSON is the gate.
# PNGs are ~830 KB each and change whenever a baseline is re-recorded.
/tools/render-baseline/*.png
